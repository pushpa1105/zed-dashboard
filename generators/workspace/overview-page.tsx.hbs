import { useTranslation } from '@/core/i18n/use-translation';
import { Page } from '@/core/layout/page';
import { StatCard } from '@/shared/components/dashboard/stat-card';

import { use{{pascalCase name}} } from '../api/{{kebabCase name}}';

export default function OverviewPage() {
  const { t } = useTranslation('{{kebabCase name}}');
  const query = use{{pascalCase name}}();

  return (
    <Page width="full" title={t('overview.title')} description={t('overview.description')}>
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <StatCard
          label={t('overview.total')}
          value={query.data?.meta.total}
          loading={query.isPending}
        />
      </div>
    </Page>
  );
}
