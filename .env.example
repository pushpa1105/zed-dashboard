# Copy to .env (or .env.local) and adjust.
# Only variables prefixed with VITE_APP_ are exposed to the app (validated in src/core/config/env.ts).

VITE_APP_NAME="zed-dashboard"
# Base URL of your backend API.
VITE_APP_API_URL=/api
# true = intercept requests with the MSW mock API (no backend needed).
VITE_APP_ENABLE_API_MOCKING=true
VITE_APP_DEFAULT_LOCALE=en
# Demo storefront only. Checkout link per product; {product} becomes a dashboard id or "complete".
# Leave empty in customer builds: prices and buy buttons disappear.
VITE_APP_STORE_URL=
